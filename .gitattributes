.gitattributes export-ignore
.gitignore export-ignore

# All OceanBase code is auto-formatted using clang-format.
*.c filter=codeformat
*.cc filter=codeformat
*.cpp filter=codeformat
*.h filter=codeformat
*.hpp filter=codeformat
*.i filter=codeformat
*.ic filter=codeformat
*.js filter=codeformat

# Keep build inputs and shell entry points portable across Git checkouts.
*.sh text eol=lf
*.py text eol=lf
*.lock text eol=lf
Dockerfile text eol=lf
